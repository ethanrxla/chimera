# Copy this file to .env and fill in the values that apply to your setup.
# .env is gitignored. Never commit real secrets.

# ── Supabase (optional — only needed for sync-db / artifact persistence) ────
DATABASE_PASSWORD=
SUPABASE_URL=
DIRECT_CONNECTION=
PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
ANON_KEY=
SECRET_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-v1-...
# LLM_API_KEY mirrors whichever key Strix/adapters should use
LLM_API_KEY=sk-ant-...

# ── Tool API keys ─────────────────────────────────────────────────────────────
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=fc-...

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Chimera

# ── LangGraph (if running a local LangGraph dev server on the host) ───────────
# NOTE: use host.docker.internal (not 127.0.0.1) — containers cannot reach the
# host loopback via 127.0.0.1 on native Linux Docker Engine.
LANGGRAPH_API_URL=http://host.docker.internal:2024

# ── Chimera runtime ───────────────────────────────────────────────────────────
SHANNON_BASE_URL=http://shannon:8080
# Model for Strix to use (anthropic/<model> or openai/<model>)
STRIX_LLM=anthropic/claude-haiku-4-5-20251001

CHIMERA_ALLOWED_BINARIES=python,python3,autoswagger,strix,zypheron,nmap,masscan,subfinder,amass,nuclei,nikto,httpx,dnsx
CHIMERA_ALLOW_DESTRUCTIVE=false

ZYPHERON_BINARY=zypheron
VIBEPENTESTER_WORKDIR=/app/tools/vibe-pentester
DECEPTICON_WORKDIR=/app/tools/decepticon

# ── HexStrike MCP bridge ──────────────────────────────────────────────────────
HEXSTRIKE_ENABLED=true
HEXSTRIKE_MCP_COMMAND=python3
HEXSTRIKE_MCP_ENTRYPOINT=/app/tools/hexstrike-mcp/hexstrike_mcp.py
HEXSTRIKE_SERVER_URL=http://hexstrike:8888

# ── Local LLM — sec-llm / vLLM (local-llm profile only) ─────────────────────
# Required to download model weights from Hugging Face on first start.
HUGGING_FACE_HUB_TOKEN=hf_...

# Preset selects the model loaded by the vLLM container.
# Available: whiterabbit-qwen | whiterabbit-13b | whiterabbit-llama-8b | deephat
LOCAL_LLM_PRESET=whiterabbit-13b

# Context window. 4096 is safe for 12 GB VRAM with the 13B AWQ preset.
# Increase to 8192 if VRAM headroom allows.
LOCAL_LLM_MAX_MODEL_LEN=4096

# Fraction of GPU VRAM reserved by vLLM (0.82 * 12 GB ≈ 9.8 GB).
# Lower to 0.75 if OOM on first load.
LOCAL_LLM_GPU_MEMORY_UTILIZATION=0.82

# Shannon must be explicitly pointed at sec-llm; its default provider is Anthropic.
# Set SHANNON_MODEL to the served-model-name that matches the preset above:
#   whiterabbit-qwen      → Mistral-7B-Instruct-v0.3-AWQ
#   whiterabbit-13b       → WhiteRabbitNeo-13B-AWQ
#   whiterabbit-llama-8b  → Llama-3.1-WhiteRabbitNeo-2-8B
#   deephat               → DeepHat-V1-7B
SHANNON_PROVIDER=openai_compatible
SHANNON_MODEL=WhiteRabbitNeo-13B-AWQ
