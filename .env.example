# Copy this file to .env and fill in the values that apply to your setup.
# .env is gitignored. Never commit real secrets.

# ── Supabase (optional — only needed for sync-db / artifact persistence) ────
DATABASE_PASSWORD=
SUPABASE_URL=
DIRECT_CONNECTION=
PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
ANON_KEY=
SECRET_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-v1-...
# LLM_API_KEY mirrors whichever key Strix/adapters should use
LLM_API_KEY=sk-ant-...

# ── Tool API keys ─────────────────────────────────────────────────────────────
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=fc-...

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Chimera

# ── LangGraph (if running a local LangGraph dev server on the host) ───────────
# NOTE: use host.docker.internal (not 127.0.0.1) — containers cannot reach the
# host loopback via 127.0.0.1 on native Linux Docker Engine.
LANGGRAPH_API_URL=http://host.docker.internal:2024

# ── Chimera runtime ───────────────────────────────────────────────────────────
SHANNON_BASE_URL=http://shannon:8080
SHANNON_HOST_PORT=18080
# Model for Strix to use (anthropic/<model> or openai/<model>)
STRIX_LLM=anthropic/claude-haiku-4-5-20251001

CHIMERA_ALLOWED_BINARIES=python,python3,autoswagger,strix,zypheron,nmap,masscan,subfinder,amass,nuclei,nikto,httpx,dnsx
CHIMERA_ALLOW_DESTRUCTIVE=false

ZYPHERON_BINARY=zypheron
VIBEPENTESTER_WORKDIR=/app/tools/vibe-pentester
DECEPTICON_WORKDIR=/app/tools/decepticon

# ── HexStrike MCP bridge ──────────────────────────────────────────────────────
HEXSTRIKE_ENABLED=true
HEXSTRIKE_MCP_COMMAND=python3
HEXSTRIKE_MCP_ENTRYPOINT=/app/tools/hexstrike-mcp/hexstrike_mcp.py
HEXSTRIKE_SERVER_URL=http://hexstrike:8888

# ── Local LLM — Ollama + GGUF (recommended for RTX 50-series / Blackwell) ────
# Ollama + llama.cpp selects CUDA kernels at runtime — handles Blackwell (sm_120)
# natively. Pull the model once after starting the ollama profile:
#
#   COMPOSE_PROFILES=ollama docker compose up -d ollama
#   docker exec ollama-gpu ollama pull hf.co/bartowski/WhiteRabbitNeo-13B-v1-GGUF:Q4_K_M
#
# Set SHANNON_MODEL to the exact name shown by `docker exec ollama-gpu ollama list`.
SHANNON_PROVIDER=openai_compatible
SHANNON_OPENAI_BASE_URL=http://ollama:11434/v1
SHANNON_MODEL=hf.co/bartowski/WhiteRabbitNeo-13B-v1-GGUF:Q4_K_M
# 7B fallback (~4 GB VRAM):
# SHANNON_MODEL=hf.co/bartowski/WhiteRabbitNeo-V3-7B-GGUF:IQ4_XS

# Shannon oracle defaults for this instance: local chain first, GPT-5.4 oracle on top
SHANNON_ORACLE_ENABLED=true
SHANNON_ORACLE_PROVIDER=openai
# Presets: anthropic | openai | openai_compatible | nvidia_nim | ollama
SHANNON_ORACLE_MODEL=gpt-5.4
SHANNON_ORACLE_REASONING=medium
SHANNON_ORACLE_BASE_URL=
SHANNON_ORACLE_API_KEY=
SHANNON_ANTHROPIC_PROMPT_CACHING=true
SHANNON_ANTHROPIC_CACHE_TTL=5m
SHANNON_AGENT_COMPACTION_THRESHOLD=6
SHANNON_AGENT_COMPACTION_KEEP_RECENT=2
SHANNON_PROMPT_DIR=/app/prompts
NVIDIA_API_KEY=nvapi-...

# Chimera autonomous Shannon planner defaults
CHIMERA_PIPELINE_STRATEGY=phased_autonomous
CHIMERA_SHANNON_AUTONOMOUS_ENABLED=true
CHIMERA_SHANNON_AUTONOMOUS_PROVIDER_PRESET=nvidia_nim
CHIMERA_SHANNON_AUTONOMOUS_MODEL=meta/llama-4-maverick-17b-128e-instruct
CHIMERA_SHANNON_AUTONOMOUS_BASE_URL=https://integrate.api.nvidia.com/v1
CHIMERA_SHANNON_AUTONOMOUS_MAX_TURNS=80
CHIMERA_SHANNON_AUTONOMOUS_MAX_TOOL_CALLS=14
CHIMERA_SHANNON_AUTONOMOUS_MAX_RETRIES=2
CHIMERA_SHANNON_AUTONOMOUS_REASONING_EFFORT=medium
CHIMERA_SHANNON_AUTONOMOUS_REPO_PATH=
CHIMERA_SHANNON_AUTO_CREATE_BROWSER_SESSION=true
CHIMERA_SHANNON_BROWSER_SESSION_MODE=mediated
CHIMERA_SHANNON_ZAP_MCP_ENABLED=true
# Optional role overrides
# CHIMERA_EXPLOIT_PROVIDER=anthropic
# CHIMERA_EXPLOIT_MODEL=claude-sonnet-4-20250514
# CHIMERA_REPORT_PROVIDER=ollama
# CHIMERA_REPORT_MODEL=qwen2.5-coder:7b

# Browser tools used by Shannon's oracle. Keep headless=true in Docker unless
# you explicitly wire the container to your desktop display and want live Chromium windows.
SHANNON_BROWSER_HEADLESS=true
SHANNON_BROWSER_DEVTOOLS=false
SHANNON_BROWSER_SLOW_MO_MS=0
SHANNON_BROWSER_EXECUTOR_MODE=direct
CHIMERA_CORE_URL=http://chimera-core:8000
ZAP_BASE_URL=http://zap:8090
ZAP_API_KEY=chimera-zap-key
SHANNON_ZAP_SPIDER_TIMEOUT_S=90
SHANNON_ZAP_ALERT_LIMIT=20
SHANNON_ZAP_SITE_LIMIT=50
SHANNON_ZAP_POLL_INTERVAL_S=1.0

# ── Local LLM — vLLM / sec-llm (alternative, local-llm profile) ──────────────
# NOTE: vLLM AWQ crashes on Blackwell (RTX 50-series / sm_120). Use Ollama above.
# HUGGING_FACE_HUB_TOKEN=hf_...
# LOCAL_LLM_PRESET=whiterabbit-13b
# LOCAL_LLM_MAX_MODEL_LEN=4096
# LOCAL_LLM_GPU_MEMORY_UTILIZATION=0.82
